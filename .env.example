# Aucune variable n'est requise pour le front-end actuel (tout est simulé).
# Variables prévues pour le backend :

# Secret partagé avec le proxy MCBloc (commande /site, récompenses en attente)
# LINK_SECRET=

# Base MySQL mcbloc (ou API intermédiaire)
# DATABASE_URL=

# Prestataire de paiement (Tebex ou Stripe)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
